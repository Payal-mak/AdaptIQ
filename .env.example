# Copy this file to .env and fill in real values. Never commit .env.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://adaptiq:adaptiq@localhost:5432/adaptiq

# LLM provider: groq (default) or gemini (fallback)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Secret used to sign JWT tokens. Must be 32+ characters and NOT this placeholder; the app refuses to start otherwise.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=t4h9w0YQkhg6Y13r-aja1lL1Bmk8xV1Q5lli26tKk3qv01PkOpXAjKUWH8Eh3i9Z

# Minutes until a login token expires
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Optional: if set (e.g. college.edu), student self-registration only accepts that email domain. Empty = allow any.
ALLOWED_EMAIL_DOMAIN=marwadiuniversity.ac.in
