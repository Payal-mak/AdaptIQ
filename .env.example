# Copy this file to .env and fill in real values. Never commit .env.
# This file must only contain placeholders, never real keys or secrets.

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://adaptiq:adaptiq@localhost:5432/adaptiq

# --- LLM ---
# Primary and fallback provider: groq or gemini
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-4-hydrogen

LLM_TIMEOUT_SECONDS=30
# Retries AFTER the first try, per provider (2 = up to 3 attempts)
LLM_MAX_RETRIES=2
# If a provider asks us to wait longer than this (Retry-After), skip to the fallback instead of waiting
LLM_MAX_RETRY_WAIT_SECONDS=20
# Save prompt/response text in the llm_calls table? Keep false: prompts contain student answers.
LLM_LOG_PAYLOADS=false

# Optional price per 1 million tokens in USD (0 = free tier)
GROQ_INPUT_PRICE_PER_M=0
GROQ_OUTPUT_PRICE_PER_M=0
GEMINI_INPUT_PRICE_PER_M=0
GEMINI_OUTPUT_PRICE_PER_M=0

# Secret used to sign JWT tokens. Must be 32+ characters and NOT this placeholder; the app refuses to start otherwise.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=6JZzdcw92YRaNURDpHflP3wLAIWWP7J6D---azmrrM88mLuA56jUe_sV7OIUmxi1

# Minutes until a login token expires
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Optional: if set (e.g. college.edu), student self-registration only accepts that email domain. Empty = allow any.
ALLOWED_EMAIL_DOMAIN=
